# AI Business Twin - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# SQLite (default for development — no external database needed)
DATABASE_URL=sqlite:///./ai_business_twin.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://username:password@localhost:5432/ai_business_twin

SECRET_KEY=change_this_in_development
